        <LabelStyle><scale>0</scale></LabelStyle>
    </Style>
    <Style id="redZoneStyle">
        <LineStyle><color>aa0000ff</color><width>2</width></LineStyle>
        <PolyStyle><color>220000ff</color><fill>1</fill><outline>1</outline></PolyStyle>
    </Style>
    <Folder>
        <name>Green zones</name>
   		<description>Green zones correspond to sites with available capacity and strong monetization opportunity.</description>
